generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id            String   @id @default(uuid())
  slug          String   @unique
  brand         String
  name          String
  category      String
  shades        String[]
  stock         Int      @default(0)
  note          String?
  imageUrl      String?
  price         Float
  discountPrice Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Category {
  id   String @id @default(uuid())
  name String @unique
}

model Brand {
  id   String @id @default(uuid())
  name String @unique
}
